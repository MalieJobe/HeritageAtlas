# Supabase — Project Settings → API → Project URL
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase — Project Settings → API Keys → "publishable" key (sb_publishable_...).
# This is the browser-safe key (formerly called "anon"); used by both the
# browser and server clients via @supabase/ssr.
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# Copy this file to .env and fill in the values. .env is git-ignored.

# --- End-to-end tests (Playwright) ---
# A pre-existing test account the e2e suite logs into (it never signs up). Put
# these in a git-ignored .env.test (or the shell env) before running `pnpm e2e`.
# E2E_EMAIL="e2e.tester@example.com"
# E2E_PASSWORD="your-test-password"
